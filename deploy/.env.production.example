# .env.production — runtime da API e do nginx do web (env_file dos dois serviços).
# Na VPS: <pasta>/.env.production, criado sem sudo, chmod 660, sem CRLF.
# NODE_ENV, HOST e CORS_ORIGIN são fixados pelo compose.
PORT=3000

# Chave entre nginx e API. Mínimo 32 caracteres, única por ambiente: openssl rand -base64 48
# Nunca use prefixo VITE_: iria para o bundle público.
INTERNAL_API_KEY=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# Verificação de banco (ms)
DB_VERIFY_CONNECT_TIMEOUT_MS=10000
DB_VERIFY_QUERY_TIMEOUT_MS=8000

# Rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

JSON_BODY_LIMIT=32kb

# Extrator de mídia (opcionais — se MEDIA_DOWNLOAD_SECRET ficar vazia, deriva de INTERNAL_API_KEY)
MEDIA_DOWNLOAD_SECRET=
MEDIA_MAX_DOWNLOAD_BYTES=524288000
MEDIA_DOWNLOAD_TOKEN_TTL_SECONDS=900
YTDLP_BINARY_PATH=yt-dlp
# Opcional: caminho no container para cookies Netscape do yt-dlp (ex.: /run/ytdlp/cookies.txt via ./secrets:/run/ytdlp:ro)
YTDLP_COOKIES_PATH=
FFMPEG_BINARY_PATH=ffmpeg
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
