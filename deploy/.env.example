# .env — só interpolação do Compose (${DOMAIN}, ${TRAEFIK_*}, ${IMAGE_TAG}).
# Na VPS: <pasta>/.env, criado sem sudo, chmod 600 (o executor de deploy regrava), sem CRLF.
DOMAIN=toolbox.bevilabs.com.br
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# IMAGE_TAG é gravada automaticamente pelo deploy.sh a cada deploy. Não edite.
