HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
INTERNAL_API_KEY=change-me-to-a-long-random-string-min-32-chars
DB_VERIFY_CONNECT_TIMEOUT_MS=10000
DB_VERIFY_QUERY_TIMEOUT_MS=8000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
JSON_BODY_LIMIT=32kb

# Extrator de mídia (opcionais — MEDIA_DOWNLOAD_SECRET deriva de INTERNAL_API_KEY se omitida)
MEDIA_DOWNLOAD_SECRET=
MEDIA_MAX_DOWNLOAD_BYTES=524288000
MEDIA_DOWNLOAD_TOKEN_TTL_SECONDS=900
YTDLP_BINARY_PATH=yt-dlp
# Caminho opcional de cookies Netscape (ex.: /run/ytdlp/cookies.txt em VPS com bloqueio anti-bot do YouTube)
YTDLP_COOKIES_PATH=
FFMPEG_BINARY_PATH=ffmpeg
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
