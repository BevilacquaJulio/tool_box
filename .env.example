# Public domain (Traefik)
DOMAIN=toolbox.seudominio.com.br
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Backend runtime (Compose forces NODE_ENV=production, HOST=0.0.0.0 and
# CORS_ORIGIN=https://${DOMAIN} in docker-compose.yml)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://toolbox.seudominio.com.br

# Internal key (nginx -> API). Min 32 chars, distinct per environment.
# Never use a VITE_ prefix — it must not go into the browser bundle.
INTERNAL_API_KEY=troque-por-uma-chave-aleatoria-bem-longa-32chars

DB_VERIFY_CONNECT_TIMEOUT_MS=10000
DB_VERIFY_QUERY_TIMEOUT_MS=8000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
JSON_BODY_LIMIT=32kb
